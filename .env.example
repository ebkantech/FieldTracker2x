# Base URL of the OmegaERP backend (no trailing slash)
ERP_API_BASE=http://127.0.0.1:8000
# Shared field-ingest token — must equal OmegaERP's FIELD_INGEST_TOKEN.
# Kept server-side only (NOT prefixed NEXT_PUBLIC), so it never ships to the browser.
FIELD_INGEST_TOKEN=replace-with-a-long-random-token
